# Copy to `.env.production` (loaded by plain `vite build`, whose default mode is production)
# and set the API origin that the DEPLOYED browser can reach. Then REBUILD.
# Changing an environment variable on the static host after the build does nothing:
# the value is already a string literal inside dist/assets/*.js.
#
# PUBLIC client configuration. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=https://api.example.test

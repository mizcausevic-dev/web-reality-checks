# Loaded by Vite in `--mode development` (dev server default; `vite build --mode development`).
# PUBLIC client configuration: anything prefixed VITE_ is stamped into the shipped bundle.
# 8787 is the developer's conventional local API port in this fixture; the tests and demo
# override it with an ephemeral port via process.env (process.env wins over .env files).
VITE_API_BASE_URL=http://127.0.0.1:8787

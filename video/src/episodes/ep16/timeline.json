  "captions": [
    {
      "start": 0.6,
      "end": 6.25,
      "text": "Eight keystrokes, eight requests. Then 429: Too Many Requests."
    },
    {
      "start": 6.25,
      "end": 11.28,
      "text": "Nothing is broken. The app is being rate-limited."
    },
    {
      "start": 11.28,
      "end": 17.85,
      "text": "Fixed window: 5 allowed per 10 s, per identity."
    },
    {
      "start": 17.85,
      "end": 26.62,
      "text": "The sixth gets 429 + Retry-After. Rejected requests are not counted here."
    },
    {
      "start": 26.62,
      "end": 31.6,
      "text": "Immediate retry: the window hasn't moved. Rejected again."
    },
    {
      "start": 31.6,
      "end": 37.2,
      "text": "Observed: 8 keystrokes → 17 requests, 12 × 429."
    },
    {
      "start": 37.2,
      "end": 44.09,
      "text": "Debounce: send only after 250 ms of no typing."
    },
    {
      "start": 44.09,
      "end": 48.69,
      "text": "Same 8 keystrokes → 1 request."
    },
    {
      "start": 48.69,
      "end": 52.88,
      "text": "Responses can arrive out of order."
    },
    {
      "start": 52.88,
      "end": 61.95,
      "text": "A sequence number: apply a response only if it is still the latest."
    },
    {
      "start": 61.95,
      "end": 65.78,
      "text": "AbortController cancels the obsolete request."
    },
    {
      "start": 65.78,
      "end": 72.67,
      "text": "An abort does not prove the server stopped processing."
    },
    {
      "start": 72.67,
      "end": 79.01,
      "text": "Retry-After: round up, wait, retry the current query at most once."
    },
    {
      "start": 79.01,
      "end": 85.35,
      "text": "Query changed? Cancel the retry. Real 429s may omit the header."
    },
    {
      "start": 85.35,
      "end": 91.36,
      "text": "Flawed: 17 requests, 12 × 429, results for \"p\"."
    },
    {
      "start": 91.36,
      "end": 97.37,
      "text": "Corrected: 1 request, 0 × 429, results for \"postgres\"."
    },
    {
      "start": 97.37,
      "end": 101.72,
      "text": "Coordinate the work. Don't just repeat it faster."
    },
    {
      "start": 101.72,
      "end": 108.25,
      "text": "Debouncing is not server-side limiting. Don't reuse this retry policy for writes."
    }
  ]
}